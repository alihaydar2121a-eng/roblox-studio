{
  "name": "OperationIronfront",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 40,
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 45
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 6
      }
    },
    "Teams": { "$className": "Teams" },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 768,
        "StreamingMinRadius": 128,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2.2,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4
      }
    }
  }
}
